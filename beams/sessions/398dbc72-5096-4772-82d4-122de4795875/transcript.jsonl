;\n    outline: none;\n  }\n  .controls input[type=\"text\"]:focus {\n    border-color: var(--accent);\n  }\n  .filter-btn {\n    padding: 8px 16px;\n    border-radius: 999px;\n    border: 1px solid var(--border);\n    background: var(--panel);\n    color: var(--text-dim);\n    cursor: pointer;\n    font-size: 13px;\n    font-weight: 600;\n    transition: all 0.15s ease;\n    white-space: nowrap;\n  }\n  .filter-btn:hover {\n    background: var(--panel-hover);\n    color: var(--text);\n  }\n  .filter-btn.active {\n    background: var(--accent-soft);\n    border-color: var(--accent);\n    color: var(--accent);\n  }\n  .surprise-btn {\n    padding: 8px 16px;\n    border-radius: 999px;\n    border: 1px solid var(--accent);\n    background: var(--accent);\n    color: #06202f;\n    cursor: pointer;\n    font-size: 13px;\n    font-weight: 700;\n  }\n  .surprise-btn:hover {\n    filter: brightness(1.08);\n  }\n  main {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 32px 24px 80px;\n  }\n  .count {\n    text-align: center;\n    color: var(--text-dim);\n    font-size: 13px;\n    margin-bottom: 20px;\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n    gap: 16px;\n  }\n  .card {\n    background: var(--panel);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    padding: 18px 20px;\n    transition: transform 0.15s ease, border-color 0.15s ease;\n    position: relative;\n  }\n  .card.highlight {\n    border-color: var(--accent);\n    box-shadow: 0 0 0 3px var(--accent-soft);\n  }\n  .card-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 10px;\n  }\n  .card h3 {\n    margin: 0 0 6px;\n    font-size: 17px;\n  }\n  .tag {\n    display: inline-block;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.4px;\n    padding: 4px 9px;\n    border-radius: 6px;\n    background: var(--accent-soft);\n    color: var(--accent);\n    white-space: nowrap;\n  }\n  .card p {\n    margin: 8px 0 10px;\n    color: var(--text-dim);\n    font-size: 14px;\n    line-height: 1.5;\n  }\n  .meta {\n    display: flex;\n    gap: 12px;\n    font-size: 12px;\n    color: var(--text-dim);\n    border-top: 1px solid var(--border);\n    padding-top: 10px;\n    margin-top: 8px;\n  }\n  .check {\n    position: absolute;\n    top: 14px;\n    right: 14px;\n    cursor: pointer;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    border: 2px solid var(--border);\n    background: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: transparent;\n    font-size: 13px;\n  }\n  .card.done .check {\n    background: var(--accent);\n    border-color: var(--accent);\n    color: #06202f;\n  }\n  .card.done h3, .card.done p {\n    opacity: 0.45;\n    text-decoration: line-through;\n  }\n  footer {\n    text-align: center;\n    color: var(--text-dim);\n    font-size: 12px;\n    padding-bottom: 40px;\n  }\n  .empty {\n    text-align: center;\n    color: var(--text-dim);\n    padding: 60px 0;\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <h1>🌲 Things To Do in Seattle</h1>\n  <p>A curated list of landmarks, food, nature, and neighborhoods — click a card's circle to check it off.</p>\n</header>\n\n<div class=\"controls\">\n  <input type=\"text\" id=\"search\" placeholder=\"Search (e.g. coffee, view, free)...\">\n  <button class=\"filter-btn active\" data-cat=\"all\">All</button>\n  <button class=\"filter-btn\" data-cat=\"Landmarks\">Landmarks</button>\n  <button class=\"filter-btn\" data-cat=\"Outdoors\">Outdoors</button>\n  <button class=\"filter-btn\" data-cat=\"Food & Drink\">Food & Drink</button>\n  <button class=\"filter-btn\" data-cat=\"Culture\">Culture</button>\n  <button class=\"filter-btn\" data-cat=\"Neighborhoods\">Neighborhoods</button>\n  <button class=\"surprise-btn\" id=\"surprise\">🎲 Surprise Me</button>\n</div>\n\n<main>\n  <div class=\"count\" id=\"count\"></div>\n  <div class=\"grid\" id=\"grid\"></div>\n  <div class=\"empty\" id=\"empty\" style=\"display:none;\">No spots match that search.</div>\n</main>\n\n<footer>Made for exploring the Emerald City. Progress is saved in your browser.</footer>\n\n<script>\nconst activities = [\n  { name: \"Space Needle\", cat: \"Landmarks\", desc: \"574-ft observation tower with a rotating glass floor and skyline views over Puget Sound.\", meta: \"Downtown · $$$\" },\n  { name: \"Pike Place Market\", cat: \"Food & Drink\", desc: \"Historic farmers market with fishmongers tossing salmon, flower stalls, and the original Starbucks.\", meta: \"Downtown · Free to browse\" },\n  { name: \"Chihuly Garden and Glass\", cat: \"Culture\", desc: \"Dale Chihuly's blown-glass sculptures displayed indoors and in a garden, next to the Space Needle.\", meta: \"Downtown · $$\" },\n  { name: \"Museum of Pop Culture (MoPOP)\", cat: \"Culture\", desc: \"Frank Gehry-designed building housing exhibits on music, sci-fi, and pop culture, including a Nirvana collection.\", meta: \"Seattle Center · $$\" },\n  { name: \"Kerry Park\", cat: \"Outdoors\", desc: \"The classic postcard viewpoint of the Space Needle and downtown skyline, especially at sunset.\", meta: \"Queen Anne · Free\" },\n  { name: \"Discovery Park\", cat: \"Outdoors\", desc: \"Seattle's largest park — forest trails, bluffs, a lighthouse, and beach along Puget Sound.\", meta: \"Magnolia · Free\" },\n  { name: \"Pioneer Square\", cat: \"Neighborhoods\", desc: \"Seattle's oldest neighborhood: Victorian architecture, art galleries, and the Underground Tour.\", meta: \"Downtown · Free to walk\" },\n  { name: \"Seattle Underground Tour\", cat: \"Culture\", desc: \"Guided walk through the buried storefronts and sidewalks left after the Great Fire of 1889.\", meta: \"Pioneer Square · $$\" },\n  { name: \"Fremont Troll\", cat: \"Landmarks\", desc: \"A giant concrete troll sculpture clutching a real VW Beetle, tucked under the Aurora Bridge.\", meta: \"Fremont · Free\" },\n  { name: \"Ballard Locks (Hiram M. Chittenden Locks)\", cat: \"Outdoors\", desc: \"Watch boats rise and fall between fresh and salt water, plus a fish ladder for salmon runs.\", meta: \"Ballard · Free\" },\n  { name: \"Seattle Great Wheel\", cat: \"Landmarks\", desc: \"175-ft Ferris wheel on the waterfront pier with enclosed gondolas and bay views.\", meta: \"Waterfront · $$\" },\n  { name: \"Olympic Sculpture Park\", cat: \"Outdoors\", desc: \"Free outdoor art park by the water with large-scale sculptures and Olympic Mountains views.\", meta: \"Waterfront · Free\" },\n  { name: \"Woodland Park Zoo\", cat: \"Outdoors\", desc: \"90-acre zoo known for naturalistic habitats, including gorillas, jaguars, and a butterfly garden.\", meta: \"Phinney Ridge · $$\" },\n  { name: \"Museum of Flight\", cat: \"Culture\", desc: \"One of the largest air and space museums in the world, with a real Concorde and Air Force One.\", meta: \"Tukwila · $$\" },\n  { name: \"Seattle Aquarium\", cat: \"Culture\", desc: \"Puget Sound marine life, otters, and a new Ocean Pavilion on the waterfront.\", meta: \"Waterfront · $$\" },\n  { name: \"Gas Works Park\", cat: \"Outdoors\", desc: \"Former gasification plant turned park with skyline views over Lake Union and kite-flying hills.\", meta: \"Wallingford · Free\" },\n  { name: \"Capitol Hill\", cat: \"Neighborhoods\", desc: \"Seattle's nightlife and LGBTQ+ hub — bars, live music, indie shops, and Volunteer Park.\", meta: \"Capitol Hill · Free to walk\" },\n  { name: \"International District\", cat: \"Neighborhoods\", desc: \"Historic Chinatown, Japantown, and Little Saigon with dim sum, night markets, and the Wing Luke Museum.\", meta: \"ID/Chinatown · Free to walk\" },\n  { name: \"Alki Beach\", cat: \"Outdoors\", desc: \"West Seattle's sandy beach boardwalk with skyline views, bike paths, and beach bonfires.\", meta: \"West Seattle · Free\" },\n  { name: \"Ferry to Bainbridge Island\", cat: \"Outdoors\", desc: \"35-minute Washington State Ferry ride with downtown and mountain views, plus a walkable island town.\", meta: \"Colman Dock · $\" },\n  { name: \"Volunteer Park & Conservatory\", cat: \"Outdoors\", desc: \"Olmsted-designed park with a Victorian glass conservatory, water tower viewpoint, and Asian Art Museum.\", meta: \"Capitol Hill · Free\" },\n  { name: \"Klondike Gold Rush National Historical Park\", cat: \"Culture\", desc: \"Free NPS museum in Pioneer Square telling the story of Seattle's 1890s gold rush boom.\", meta: \"Pioneer Square · Free\" },\n  { name: \"Seattle Central Library\", cat: \"Landmarks\", desc: \"Rem Koolhaas's striking glass-and-steel building — worth a visit for the architecture alone.\", meta: \"Downtown · Free\" },\n  { name: \"T-Mobile Park / Lumen Field\", cat: \"Culture\", desc: \"Catch a Mariners game (retractable roof) or a Seahawks/Sounders match right next door.\", meta: \"SoDo · $$-$$$\" },\n  { name: \"Coffee crawl (Original Starbucks, local roasters)\", cat: \"Food & Drink\", desc: \"Beyond the original Starbucks location, try local roasters like Victrola, Ballard Coffee Works, or Storyville.\", meta: \"Citywide · $\" },\n  { name: \"Salmon Bay / Fishermen's Terminal\", cat: \"Neighborhoods\", desc: \"Working fishing harbor with seafood restaurants and views of Alaska-bound fishing boats.\", meta: \"Ballard · Free\" },\n  { name: \"Snoqualmie Falls day trip\", cat: \"Outdoors\", desc: \"A 268-ft waterfall (bigger than Niagara in height) just 30 minutes east of the city.\", meta: \"Snoqualmie · Free\" }\n];\n\nconst grid = document.getElementById('grid');\nconst countEl = document.getElementById('count');\nconst emptyEl = document.getElementById('empty');\nconst searchInput = document.getElementById('search');\nconst filterBtns = document.querySelectorAll('.filter-btn');\nlet activeCat = 'all';\nlet searchTerm = '';\nlet highlightIdx = null;\n\nconst STORAGE_KEY = 'seattle-todo-done';\nfunction loadDone() {\n  try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }\n  catch { return {}; }\n}\nfunction saveDone(done) {\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(done));\n}\nlet done = loadDone();\n\nfunction render() {\n  const term = searchTerm.trim().toLowerCase();\n  const filtered = activities.filter((a, i) => {\n    const catMatch = activeCat === 'all' || a.cat === activeCat;\n    const textMatch = !term || (a.name + ' ' + a.desc + ' ' + a.cat).toLowerCase().includes(term);\n    return catMatch && textMatch;\n  });\n\n  grid.innerHTML = '';\n  emptyEl.style.display = filtered.length ? 'none' : 'block';\n  countEl.textContent = filtered.length + ' spot' + (filtered.length === 1 ? '' : 's');\n\n  filtered.forEach((a) => {\n    const idx = activities.indexOf(a);\n    const card = document.createElement('div');\n    card.className = 'card' + (done[a.name] ? ' done' : '') + (idx === highlightIdx ? ' highlight' : '');\n    card.innerHTML = `\n      <button class=\"check\" data-name=\"${a.name}\">✓</button>\n      <div class=\"card-top\">\n        <h3>${a.name}</h3>\n      </div>\n      <span class=\"tag\">${a.cat}</span>\n      <p>${a.desc}</p>\n      <div class=\"meta\"><span>${a.meta}</span></div>\n    `;\n    grid.appendChild(card);\n  });\n}\n\ngrid.addEventListener('click', (e) => {\n  const btn = e.target.closest('.check');\n  if (!btn) return;\n  const name = btn.dataset.name;\n  done[name] = !done[name];\n  saveDone(done);\n  render();\n});\n\nfilterBtns.forEach(btn => {\n  btn.addEventListener('click', () => {\n    filterBtns.forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    activeCat = btn.dataset.cat;\n    highlightIdx = null;\n    render();\n  });\n});\n\nsearchInput.addEventListener('input', (e) => {\n  searchTerm = e.target.value;\n  highlightIdx = null;\n  render();\n});\n\ndocument.getElementById('surprise').addEventListener('click', () => {\n  const notDone = activities.filter(a => !done[a.name]);\n  const pool = notDone.length ? notDone : activities;\n  const pick = pool[Math.floor(Math.random() * pool.length)];\n  activeCat = 'all';\n  searchTerm = '';\n  searchInput.value = '';\n  filterBtns.forEach(b => b.classList.toggle('active', b.dataset.cat === 'all'));\n  highlightIdx = activities.indexOf(pick);\n  render();\n  requestAnimationFrame(() => {\n    document.querySelector('.card.highlight')?.scrollIntoView({ behavior: 'smooth', block: 'center' });\n  });\n});\n\nrender();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
